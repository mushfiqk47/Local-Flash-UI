# ============================================
# Flash UI 2.0 — Configuration
# ============================================
# Pick ONE provider below. Uncomment its block,
# comment out the others, and fill in the values.

# ── Provider 1: Gemini (Google AI) ─────────
# Get key: https://aistudio.google.com/app/apikey
# VITE_LLM_PROVIDER=gemini
# VITE_GEMINI_API_KEY=put_your_key_here
# VITE_GEMINI_FLASH_MODEL=gemini-2.0-flash-exp
# VITE_GEMINI_PRO_MODEL=gemini-2.0-pro-exp-02-05

# ── Provider 2: Ollama (local) ─────────────
# Install: https://ollama.com
# Then pull a model: ollama pull gemma3
VITE_LLM_PROVIDER=ollama
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_MODEL=gemma4:31b-cloud

# ── Provider 3: LM Studio (local) ──────────
# Install: https://lmstudio.ai
# Load a model, then go to Server tab → Start Server
# VITE_LLM_PROVIDER=lm-studio
# VITE_LM_STUDIO_BASE_URL=http://localhost:1234/v1
# VITE_LM_STUDIO_MODEL=default
